# Required for generating the AI diagnostic report via Google Gemini
GEMINI_API_KEY=your_google_gemini_api_key_here

# Primary multimodal model for diagnostic analysis (default: gemini-4-argon)
GEMINI_MODEL=gemini-4-argon

# Cheaper, fast model used for generating summaries and translations (default: gemini-flash-lite-latest)
GEMINI_TRANSLATION_MODEL=gemini-flash-lite-latest

# Target language code for translated report and summary files (default: es-ES)
REPORT_LANG=es-ES
